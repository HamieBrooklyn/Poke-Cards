# Staging bot — run:  bash scripts/setup-staging-env.sh
# That creates .env.staging (gitignored) with <<< FILL IN >>> markers.
# Checklist: config/STAGING-FILL-IN.md  |  Full guide: docs/STAGING.md

POKEPON_RUNTIME=staging

# --- Second Discord application (staging bot) — required ---
DISCORD_TOKEN=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

DEV_GUILD_ID=
# Comma-separated Discord user IDs — /dev on staging + test access
DEVELOPER_IDS=

# --- Database (never point at production) ---
DATABASE_URL=sqlite+aiosqlite:///./data/poke_cards_staging.db

# Same card import config as prod unless you are testing imports only
CARD_SETS_CONFIG=config/card_sets.v1.yaml

# --- Web API (port 8081 — production uses 8080) ---
WEB_HOST=0.0.0.0
WEB_PORT=8081
WEB_PUBLIC_URL=https://api-staging.pokepon.org

# Site origin for OAuth redirects while testing the staging website
WEB_FRONTEND_URL=https://staging.pokepon.org/collection/

# Must include every origin you open in the browser while testing
WEB_ALLOWED_ORIGINS=https://staging.pokepon.org,https://pokepon.org,https://hamiebrooklyn.github.io,http://127.0.0.1:5500

# Generate a NEW secret — do not reuse production WEB_SESSION_SECRET
WEB_SESSION_SECRET=

# Staging Discord OAuth (same app as DISCORD_TOKEN, or staging app credentials)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Add redirect in Portal → OAuth2 → Redirects:
#   https://api-staging.pokepon.org/auth/discord/callback

# --- Stripe (optional) — use test keys and test price ids only ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://api-staging.pokepon.org/api/stripe/webhook

# --- Optional: same TCG API key as prod for rate limits ---
# TCG_API_KEY=

# Seasonal set chase (featured set + community progress bar)
SET_CHASE_ENABLED=1
SET_CHASE_SET_CODE=sv2
SET_CHASE_TITLE="Paldea Evolved Set Chase"
SET_CHASE_START=2026-06-01T00:00:00+00:00
SET_CHASE_END=2026-07-01T00:00:00+00:00
SET_CHASE_GLOBAL_TARGET=5000
SET_CHASE_DROP_BOOST_PERCENT=20
SET_CHASE_COMPLETION_PERCENT=80
SET_CHASE_REWARD_CRYSTALS=50
SET_CHASE_REWARD_PD=2500
SET_CHASE_COMMUNITY_REWARD_CRYSTALS=15
