# From Discord Developer Portal → your application → Bot → Reset Token / copy token
DISCORD_TOKEN=

# Public “Add bot” invite URL (Top.gg bot page, website, docs). Same as assets/site-links.js on the site.
# DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1496227239803748362&permissions=268954721&integration_type=0&scope=bot+applications.commands

# Message Content Intent (default ON in code). Required for chat commands: type the command
# name directly in chat (`ppcd`, `ppcoll`, `pppackd`, …) — same surface as the slash equivalents.
# Disable with DISCORD_MESSAGE_CONTENT_INTENT=0 for slash-only.
# You must also enable "Message Content Intent" under Developer Portal → Bot → Privileged Gateway Intents,
# or messages arrive with empty text and chat commands never match.
# DISCORD_MESSAGE_CONTENT_INTENT=0

# Optional: your test server ID so slash commands sync in seconds instead of up to ~1 hour (global)
# Right-click server (guild) → Copy Server ID (Developer Mode must be on in Discord settings)
DEV_GUILD_ID=

# Slash command sync policy at startup. Discord caps each app at ~200 global syncs / day and
# rate-limits the login endpoint when bounced too quickly (HTTP 429, code 40062). Default
# `auto` skips the sync when the in-memory command tree matches what we last pushed.
# Use `always` after editing a command in code to force a sync next start.
# Use `never` to skip the sync entirely while you wait out a 429.
# SLASH_SYNC=auto
# Staging / DM tutorial: also sync slash commands globally (``/cd`` autocomplete in bot DMs).
# SLASH_SYNC_GLOBAL=1

# Comma-separated Discord user IDs allowed to use /dev (e.g. set pokedollars for testing)
DEVELOPER_IDS=

# SQLite URL (relative path is resolved from cwd when running the bot)
DATABASE_URL=sqlite+aiosqlite:///./data/poke_cards.db

# Staging stack (separate bot, port 8081, api-staging.pokepon.org): copy .env.staging.example
# to .env.staging — see docs/STAGING.md. Never use production DATABASE_URL or DISCORD_TOKEN there.

# Optional Pokémon TCG API key — higher rate limits from https://pokemontcg.io/
TCG_API_KEY=

# YAML file listing TCG set IDs to import (see config/card_sets.v1.yaml)
CARD_SETS_CONFIG=config/card_sets.v1.yaml

# --- Discord monetization (optional): “half drop cooldown” durable SKU ---
# Developer Portal → your app → Monetization → copy the SKU id for your one-time purchase item.
# DISCORD_DROP_BOOST_SKU_ID=   # numeric id from /dev list_skus (same application as DISCORD_TOKEN), not store URLs
# Cooldowns in seconds (default base 600 = 10 min, premium defaults to half). For quick local tests e.g. 20 / 10.
# DROP_COOLDOWN_BASE_SECONDS=600
# DROP_COOLDOWN_PREMIUM_SECONDS=300
# Cache Discord entitlement API per user (seconds).
# DROP_BOOST_ENTITLEMENT_CACHE_TTL=120
# Comma-separated user ids treated as having the boost without an API call (local dev only).
# DROP_BOOST_TEST_USER_IDS=

# --- Discord monetization (optional): consumable booster pack SKU ---
# Developer Portal → your app → Monetization → create a **CONSUMABLE** SKU for "Booster pack".
# `/packd` shows this as an alternative to the 5,000 Pokedollar button. When a
# player buys it, on_entitlement_create grants a random active-series pack, then
# calls Discord's consume endpoint so the user can buy it again. Without this,
# `/packd` stays Pokedollar-only and `/packv` only offers Crystal purchases.
# DISCORD_PACK_CONSUMABLE_SKU_ID=

# --- Member tutorial (DM onboarding + Member role) ---
# Main server: new members get a DM tutorial; completing it grants the Member role.
# TUTORIAL_ENABLED=1
# TUTORIAL_GUILD_ID=1500891048652705843
# TUTORIAL_MEMBER_ROLE_ID=1505682058452668577
# Channel for the persistent Verify button panel (defaults below if unset)
# TUTORIAL_VERIFY_CHANNEL_ID=1500892639304876205
# TUTORIAL_VERIFY_PANEL_MESSAGE_ID=
# Channels @everyone can see BEFORE Member (comma-separated) — configure matching perms in Discord
# TUTORIAL_PRE_MEMBER_CHANNEL_IDS=1501550017289392288,1505578147024867540,1501851386596429907,1500892639304876205

# --- Personal referral invites (optional, defaults to TUTORIAL_* values) ---
# Guild + channel where the bot mints one personal Discord invite per signed-in user
# on the website. Bot needs Create Instant Invite + Manage Server in that guild.
# REFERRAL_INVITE_GUILD_ID=
# REFERRAL_INVITE_CHANNEL_ID=
#
# --- Website home page: Discord scheduled events panel ---
# Guild to read events from (defaults to TUTORIAL_GUILD_ID — official Poké Pon server).
# The bot must be a member of this guild. It needs View Channel on the event's voice/stage
# channel (or Manage Events) to list scheduled events via the API.
# DISCORD_EVENTS_GUILD_ID=1500891048652705843
# Invite code for links like https://discord.gg/CgFRtYck?event=...
# DISCORD_EVENTS_INVITE_CODE=CgFRtYck

# --- Catalog news (auto-sync recent TCG sets → website + Discord) ---
# Production: set CATALOG_NEWS_ENABLED=1 and CATALOG_NEWS_CHANNEL_ID (announcements channel).
# Staging enables by default when POKEPON_RUNTIME=staging.
# CATALOG_NEWS_ENABLED=1
# CATALOG_NEWS_CHANNEL_ID=
# CATALOG_NEWS_LOOKBACK_DAYS=60
# CATALOG_NEWS_INTERVAL_HOURS=24
# CATALOG_NEWS_MIN_CARDS_ADDED=5
# CATALOG_NEWS_MAX_SETS_PER_RUN=8

# --- Weekend global luck (official Fri–Sun event; no manual /dev luck_boost needed) ---
# Applies the same global boost as `/dev luck_boost set global 100` on a schedule.
# WEEKEND_LUCK_ENABLED=1
# WEEKEND_LUCK_PERCENT=100
# WEEKEND_LUCK_TIMEZONE=Europe/Stockholm

# Seasonal set chase — featured TCG set, community progress bar, personal binder reward.
# SET_CHASE_ENABLED=1
# SET_CHASE_SET_CODE=sv6
# SET_CHASE_TITLE="Twilight Masquerade Chase"
# SET_CHASE_START=2026-06-01T00:00:00+00:00
# SET_CHASE_END=2026-07-01T00:00:00+00:00
# SET_CHASE_GLOBAL_TARGET=5000
# SET_CHASE_DROP_BOOST_PERCENT=20
# SET_CHASE_COMPLETION_PERCENT=80
# SET_CHASE_REWARD_CRYSTALS=50
# SET_CHASE_REWARD_PD=2500
# SET_CHASE_COMMUNITY_REWARD_CRYSTALS=15

# --- Top.gg /vote rewards (optional) ---
# v1 Bearer token from: Top.gg → your project → Integrations & API (not legacy v0 “no Bearer” token).
# https://docs.top.gg/authentication
# TOPGG_API_TOKEN=
# Auto-claim vote rewards after any command (DM). Disable with TOPGG_AUTO_CLAIM_ENABLED=0
# TOPGG_AUTO_CLAIM_ENABLED=1
# TOPGG_VOTE_POLL_MIN_SECONDS=90
# Vote link for the button (or set TOPGG_BOT_ID only → https://top.gg/bot/<id>/vote)
# TOPGG_VOTE_URL=https://top.gg/bot/YOUR_DISCORD_APPLICATION_ID/vote
# TOPGG_REVIEW_URL=https://top.gg/bot/YOUR_DISCORD_APPLICATION_ID/reviews
# TOPGG_BOT_ID=
# One-time DM asking for a Top.gg review after N successful commands (default 10).
# TOPGG_REVIEW_PROMPT_ENABLED=1
# TOPGG_REVIEW_PROMPT_MIN_COMMANDS=10
#
# --- Top.gg vote webhooks (optional, automatic rewards without /vote) ---
# Top.gg → Integrations & API → Webhooks — copy the **whs_…** secret. Expose this app with HTTPS
# (reverse proxy or tunnel) to Top.gg’s webhook URL field; path must match TOPGG_WEBHOOK_PATH.
# TOPGG_WEBHOOK_SECRET=
# TOPGG_WEBHOOK_HOST=0.0.0.0
# TOPGG_WEBHOOK_PORT=8080
# TOPGG_WEBHOOK_PATH=/topgg/webhook
# TOPGG_WEBHOOK_MAX_CLOCK_SKEW=300
# Optional: your Discord **application** id — reject webhooks for other bot projects.
# TOPGG_WEBHOOK_EXPECTED_PLATFORM_ID=

# --- Public web dashboard (collection.html on the GitHub Pages site) ---
# The bot can also host an HTTP API that powers https://pokepon.org/collection/.
# Players sign in with Discord OAuth (just the `identify` scope) and the page renders the same
# `user_card_instances` rows the bot does. Everything below is OPTIONAL — without these the
# Collection page on the site stays gated behind "API offline".
#
# Listener (defaults to the Top.gg port if that webhook is also configured, so one ngrok / proxy
# can serve both surfaces).
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# Public HTTPS URL the browser hits (e.g. your ngrok tunnel or production proxy). MUST be HTTPS
# in production — session cookies use `SameSite=None` which Chromium-based browsers refuse
# without `Secure`.
# Production API (home PC via Cloudflare Tunnel): https://api.pokepon.org
# WEB_PUBLIC_URL=https://api.pokepon.org
# Dev only: WEB_PUBLIC_URL=https://your-tunnel.ngrok-free.app
# Comma-separated browser origins allowed to call /api/me/* with credentials.
# WEB_ALLOWED_ORIGINS=https://pokepon.org,https://hamiebrooklyn.github.io
# Site origin for OAuth redirects and Stripe success/cancel URLs (path is ignored).
# WEB_FRONTEND_URL=https://pokepon.org
# Long random secret used to sign the session cookie. Generate with `openssl rand -hex 32`.
# WEB_SESSION_SECRET=
# Optional: how long a session cookie stays valid (default 30 days).
# WEB_SESSION_TTL_SECONDS=2592000
#
# Discord OAuth client (Developer Portal → your app → OAuth2 → General). The client id is the
# same numeric snowflake as DISCORD_TOKEN's application; the secret is *different* — paste it
# from "Reset Secret". Add the bot's callback URL — `https://<WEB_PUBLIC_URL host>/auth/discord/callback` —
# to the OAuth2 "Redirects" list in the same page or Discord will reject the redirect.
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
#
# --- Stripe shop (optional) — https://dashboard.stripe.com ---
# Secret key: Developers → API keys → Secret key (use test keys while developing).
# STRIPE_SECRET_KEY must start with sk_test_ for sandbox; every STRIPE_PRICE_* below must be
# a price_… id created in that same sandbox (live prices with a test key → checkout fails).
# STRIPE_SECRET_KEY=sk_test_...
# Webhook: Developers → Webhooks → Add endpoint → URL must be:
#   https://<WEB_PUBLIC_URL host>/api/stripe/webhook
# Events: checkout.session.completed
# Copy the signing secret (whsec_…):
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# For each Product → one-time Price in Stripe, copy the Price id (price_…), not Product id:
# STRIPE_PRICE_POKEDOLLARS_2500=price_...
# STRIPE_PRICE_POKEDOLLARS_10000=price_...
# STRIPE_PRICE_POKEDOLLARS_50000=price_...
# STRIPE_PRICE_CRYSTALS_15=price_...
# STRIPE_PRICE_CRYSTALS_50=price_...
# STRIPE_PRICE_CRYSTALS_100=price_...
#
# Perks (replace Discord monetization SKUs when using Stripe):
# STRIPE_PRICE_HALF_DROP_COOLDOWN=price_...   # one-time; same as DISCORD_DROP_BOOST_SKU_ID
# STRIPE_PRICE_RANDOM_PACK=price_...          # repeatable; same as DISCORD_PACK_CONSUMABLE_SKU_ID
